---
import { getBasedUrl } from "@utils/paths";
import { variantPath } from "@utils/registry";
import type { CourseFormatInfo } from "@utils/registry";

interface Props {
    courseId: string;
    format: CourseFormatInfo;
}

const { courseId, format } = Astro.props;
const archiveYears = format.years.filter(
    (year) => year !== format.currentYear,
);
---

<div class="format-card">
    <div class="format-card__header">
        <h3 class="format-card__title">{format.label} форма</h3>
        <span class="format-card__year">{format.currentYear} год</span>
    </div>
    <a
        class="format-card__cta font-titles font-600 bg-bg-accent_second userActionsLinkAlt"
        href={getBasedUrl(variantPath(courseId, format.format))}
    >
        Перейти к материалам
    </a>
    {
        archiveYears.length > 0 && (
            <details class="format-card__years">
                <summary>Прошлые годы ({archiveYears.length})</summary>
                <ul class="format-card__years-list">
                    {archiveYears.map((year) => (
                        <li>
                            <a
                                class="format-card__year-link"
                                href={getBasedUrl(
                                    variantPath(courseId, format.format, year),
                                )}
                            >
                                {year} год
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        )
    }
</div>

<style>
    .format-card {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.875rem;
        background-color: var(--color-bg-secondary);
        border-radius: 30px;
    }

    .format-card__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .format-card__title {
        font-family: "NextArt", sans-serif;
        font-weight: 600;
    }

    .format-card__year {
        padding: 0.25rem 0.875rem;
        border-radius: 999px;
        background-color: var(--color-bg-accent-second);
        font-size: 1rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .format-card__cta {
        display: block;
        text-align: center;
        padding: 1rem 1.5rem;
        border-radius: 20px;
        color: inherit;
        text-decoration: none;
    }

    .format-card__years summary {
        cursor: pointer;
        text-decoration: underline;
        font-weight: 500;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }

        &:hover,
        &:focus-visible {
            color: var(--color-bg-accent-second);
        }
    }

    .format-card__years-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        margin: 0.875rem 0 0;
        padding: 0;
        list-style: none;
    }

    .format-card__year-link {
        display: inline-block;
        padding: 0.375rem 1rem;
        border: 1.5px solid var(--color-border);
        border-radius: 999px;
        color: inherit;
        text-decoration: none;
        font-size: 1rem;

        &:hover,
        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }
    }
</style>
