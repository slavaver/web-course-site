---
import { getBasedUrl } from "@utils/paths";
import { variantPath } from "@utils/registry";
import type { CourseFormatInfo } from "@utils/registry";

interface Props {
    courseId: string;
    format: CourseFormatInfo;
}

const { courseId, format } = Astro.props;
const archiveYears = format.years.filter((year) => year !== format.currentYear);
---

<div class="format-card">
    <div class="format-card__header">
        <h3 class="format-card__title">{format.label} форма</h3>
    </div>
    <a
        class="format-card__cta font-titles font-600"
        href={getBasedUrl(variantPath(courseId, format.format))}
    >
        {format.currentYear} год поступления
        <i class="format-card__goto-icon"></i>
    </a>
    {archiveYears.length > 0 && (
        <ul class="format-card__years-list">
            {archiveYears.map((year) => (
                <li>
                    <a
                        class="format-card__year-link"
                        href={getBasedUrl(
                            variantPath(courseId, format.format, year)
                        )}
                    >
                        {year}
                    </a>
                </li>
            ))}
        </ul>
    )}
</div>

<style>
    .format-card {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 1.875rem;
        border-radius: 30px;
        background-color: var(--color-bg-secondary);
    }

    .format-card__header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .format-card__title {
        font-weight: 600;
        font-family: NextArt, sans-serif;
    }

    .format-card__year {
        padding: 0.25rem 0.875rem;
        border-radius: 999px;
        background-color: var(--color-bg-accent-second);
        white-space: nowrap;
        font-weight: 500;
        font-size: 1rem;
    }

    .format-card__cta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        width: 100%;
        border: 1.5px solid var(--color-border);
        border-radius: 20px;
        color: inherit;
        text-decoration: none;
        transition-duration: 300ms;
        transition-property: background-color;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);

        &:active,
        &:hover,
        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }
    }

    .format-card__goto-icon {
        flex-shrink: 0;
        width: 50px;
        height: 50px;
        border: 1.5px solid var(--color-border);
        border-radius: 100%;
        background: url("/web-course-site/assets/img/goto.svg") no-repeat center;
        color: var(--color-border);
    }

    .format-card__years-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .format-card__year-link {
        display: inline-block;
        padding: 0.375rem 1rem;
        border: 1.5px solid var(--color-border);
        border-radius: 999px;
        color: inherit;
        text-decoration: none;
        font-size: 1rem;
        transition-duration: 300ms;
        transition-property: background-color;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);

        &:active,
        &:hover,
        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }
    }
</style>
