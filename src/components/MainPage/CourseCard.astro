---
interface Props {
    href: string;
    title: string;
    description: string;
}

const { href, title, description } = Astro.props;
---

<a aria-label="Перейти к курсу" href={href} class="course-card">
    <h3 class="course-card__title no-break-hyphen">{title}</h3>
    <div class="course-card__content">
        <p class="course-card__description">{description}</p>
        <i class="course-card__goto-icon"></i>
    </div>
</a>

<style>
    .course-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.25rem;
        border-radius: 30px;
        background-color: var(--color-bg-secondary);
        transition: background-color 300ms cubic-bezier(0.4, 0, 0.2, 1);

        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }

        @media (width >= 768px) {
            flex-direction: row;
            gap: 3.5rem;
            padding: 1.875rem;

            &:hover {
                background-color: var(--color-bg-accent-second);
            }

            &:active {
                background-color: var(--color-bg-primary);
            }
        }

        @media (width >= 1024px) {
            padding: 2.5rem;
        }

        @media (prefers-reduced-motion: reduce) {
            transition: none;
        }
    }

    .course-card__content {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 3.5rem;
        max-width: none;

        @media (width >= 768px) {
            max-width: 365px;
        }
    }

    .course-card__description {
        width: 100%;
    }

    .course-card__goto-icon {
        width: 50px;
        height: 50px;
        border: 1.5px solid var(--color-border);
        border-radius: 100%;
        background: url("/web-course-site/assets/img/goto.svg") no-repeat center;
        color: var(--color-border);
    }
</style>

<script>
    document.querySelectorAll(".no-break-hyphen").forEach((el) => {
        el.innerHTML = el.innerHTML.replace(/-/g, "&#8209;");
    });
</script>
