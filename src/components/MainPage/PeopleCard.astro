---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    name: string;
    img: ImageMetadata;
    role: string;
}

const { name, img, role } = Astro.props;
---

<div class="persons-item">
    <div class="persons-item__media">
        <Image src={img} alt="" class="persons-item__image" />
    </div>
    <div class="persons-item__body">
        <h3 class="persons-item__name">{name}</h3>
        <p class="persons-item__role">{role}</p>
    </div>
</div>

<style>
    .persons-item__media {
        display: flex;
        align-items: flex-end;
        margin-bottom: 1.25rem;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 30px;
        background-color: var(--color-bg-tertiary);
    }

    .persons-item__image {
        width: 100%;
    }

    .persons-item__name {
        margin-bottom: 0.5rem;
        line-height: 1;
    }

    html.light .persons-item__name {
        color: var(--color-text-secondary);
    }

    .persons-item__role {
        color: var(--color-text-tertiary);
        line-height: 1;
    }
</style>
