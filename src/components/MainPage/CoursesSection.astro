---
import CourseCard from "@components/MainPage/CourseCard.astro";

import { getBasedUrl } from "@utils/paths";
import { getCoursesInfo, variantPath } from "@utils/registry";

const courses = (await getCoursesInfo()).filter(
    (course) => course.formats.length > 0
);
---

<section class="courses" id="courses">
    <div class="courses__container">
        <h2 class="courses__title">Курсы</h2>
        <p class="courses__description">
            Три курса последовательно погружают в разработку на стороне клиента
        </p>
        <div class="courses__list-wrapper">
            <ul class="courses__list">
                {courses.map((course) => (
                    <li>
                        <CourseCard
                            {...course}
                            href={getBasedUrl(variantPath(course.id))}
                        />
                    </li>
                ))}
            </ul>
        </div>
    </div>
</section>

<style>
    .courses {
        padding-block: 3.75rem;
    }

    .courses__container {
        margin-inline: auto;
        padding-inline: 1.25rem;
        width: 100%;
        max-width: 1280px;

        @media (width > 768px) {
            padding-inline: 2.5rem;
        }

        @media (width > 1280px) {
            padding-inline: 1.25rem;
        }
    }

    .courses__title {
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .courses__description {
        margin-bottom: 1.2rem;
        margin-inline: auto;
        max-width: 45ch;
        text-align: center;
        text-wrap: balance;
    }

    .courses__list-wrapper {
        display: flex;
        flex-direction: column;
    }

    .courses__list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
    }

    html.light .courses__title,
    html.light .courses__description {
        color: var(--color-text-secondary);
    }
</style>
