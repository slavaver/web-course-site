---
import { getBasedUrl } from "@utils/paths";
const { path } = Astro.props;
---

<a href={path} class="back-link">
    <img
        src={getBasedUrl("/assets/img/chevron-right.svg")}
        class="back-link__icon"
        alt=""
    />
    <span class="back-link__text">Назад</span>
</a>

<style>
    .back-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
        font-weight: 700;
        font-size: 20px;
        font-family: var(--font-next-art);
    }

    .back-link__icon {
        margin-bottom: 0.25rem;
    }
</style>
