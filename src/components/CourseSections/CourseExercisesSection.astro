---
import "../../styles/courseSectionStyles.css";

import LinkCard from "@components/LinkCard.astro";
import { getBasedUrl } from "@utils/paths";
import type { CoursesItems } from "@/types/Courses";

interface Props {
    items: CoursesItems;
    /** Тип материалов секции: определяет заголовок */
    type: "labs" | "practice";
}

const { items, type } = Astro.props;

const sectionTitles = {
    labs: "Лабораторные работы",
    practice: "Практические задания",
} as const;
---

<section class="course-section">
    <h2 class="course-section__title">{sectionTitles[type]}</h2>
    <ul class="course-section__list">
        {items
            .sort((prev, next) => {
                return parseInt(prev.data.number) - parseInt(next.data.number);
            })
            .map((item) => {
                return (
                    <li>
                        <LinkCard
                            title={item.data.title}
                            number={item.data.number}
                            href={getBasedUrl(`/labs/${item.id}`)}
                        />
                    </li>
                );
            })}
    </ul>
</section>
