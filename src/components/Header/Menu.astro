---
import { getBasedUrl } from "@utils/paths";
import { getCoursesInfo, variantPath } from "@utils/registry";

const courses = (await getCoursesInfo()).filter(
    (course) => course.formats.length > 0
);
---

<nav class="menu">
    <ul class="menu__list">
        <li>
            <a class="menu__link" href={getBasedUrl("")}>
                Главная
            </a>
        </li>
        <li>
            <details>
                <summary>
                    <p>Курсы</p>
                </summary>
                <ul class="dropdown-list">
                    {courses.map((course) => (
                        <li class="dropdown-list__item">
                            <a
                                href={getBasedUrl(variantPath(course.id))}
                                class="dropdown-list__link"
                            >
                                {course.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
        </li>
        <li>
            <a class="menu__link" href={getBasedUrl("/useful/")}>
                База знаний
            </a>
        </li>
    </ul>
</nav>

<script>
    const details = document.querySelector("details")!;

    function closeDetails(e: PointerEvent) {
        if (!e.target) {
            return;
        }
        if (e.target instanceof HTMLElement) {
            if (!e.target.closest("details")) {
                details.open = false;
            }
        }
    }

    document.addEventListener("click", closeDetails);
</script>

<style>
    .menu {
        @media (width <= 768px) {
            display: none;
        }
    }

    .menu__list {
        display: flex;
        align-items: center;
        gap: clamp(0px, 2vw, 40px);
    }

    .menu__link {
        padding: 1.25rem clamp(0rem, 1vw, 1.25rem);
        border-radius: 10px;

        &:active {
            background-color: var(--color-bg-primary);
        }

        &:hover {
            background-color: var(--color-bg-accent-second);
        }

        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }
    }

    summary::after {
        display: block;
        justify-self: flex-end;
        width: 0.375rem;
        height: 0.375rem;
        box-shadow: inset 2px 2px;
        transform-origin: 50%;
        translate: 0 1px;
        rotate: 135deg;
        transition-duration: 0.2s;
        transition-property: rotate, translate;
        content: "";
        pointer-events: none;
    }

    details[open] summary::after {
        translate: 0 1px;
        rotate: 225deg;
    }

    summary {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 1.25rem clamp(0rem, 1vw, 1.25rem);
        border-radius: 10px;

        &:active {
            background-color: var(--color-bg-primary);
        }

        &:hover {
            background-color: var(--color-bg-accent-second);
        }

        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }
    }

    .dropdown-list {
        position: absolute;
        left: 50%;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1rem;
        width: max-content;
        border-radius: 1rem;
        background-color: var(--color-bg-menu);
        translate: -50% 15%;
        backdrop-filter: blur(40px);
    }

    .dropdown-list__link {
        display: block;
        padding: 1rem;
        border-radius: 10px;

        &:active {
            background-color: var(--color-bg-primary);
        }

        &:hover {
            background-color: var(--color-bg-accent-second);
        }

        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }
    }
</style>
