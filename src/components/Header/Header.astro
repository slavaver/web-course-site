---
import Logo from "./Logo.astro";
import BurgerButton from "./BurgerButton.astro";
import ThemeToggler from "./ThemeToggler.astro";
import Menu from "./Menu.astro";
import { getBasedUrl } from "@utils/paths";
import { getCoursesInfo, variantPath } from "@utils/registry";

const courses = (await getCoursesInfo()).filter(
    (course) => course.formats.length > 0
);
---

<div class="sidebar">
    <ul class="sidebar__list">
        <li class="sidebar__item">
            <a href={getBasedUrl("")} class="sidebar__link">
                Главная
            </a>
        </li>
        {courses.map((course) => (
            <li class="sidebar__item">
                <a
                    href={getBasedUrl(variantPath(course.id))}
                    class="sidebar__link"
                >
                    {course.title}
                </a>
            </li>
        ))}
        <li class="sidebar__item">
            <a href={getBasedUrl("/useful/")} class="sidebar__link">
                База знаний
            </a>
        </li>
    </ul>
</div>

<header class="header">
    <div class="header__container">
        <Logo />
        <BurgerButton />
        <Menu />
        <ThemeToggler />
    </div>
</header>

<script>
    const burgerButton = document.querySelector(".burger-button")!;
    const sidebar = document.querySelector(".sidebar")!;

    function toggleSidebar() {
        burgerButton.classList.toggle("open");
        sidebar.classList.toggle("open");
    }

    burgerButton.addEventListener("click", toggleSidebar);
</script>

<style>
    .header {
        position: fixed;
        z-index: 10;
        margin-top: 0.625rem;
        padding: 0.625rem;
        width: 100%;
    }

    .header::before {
        position: absolute;
        top: 0;
        z-index: -1;
        display: block;
        width: calc(100% - 2 * 0.625rem);
        height: 100%;
        border-radius: 1rem;
        background-color: var(--color-bg-menu);
        content: "";
        backdrop-filter: blur(40px);
    }

    .header__container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-inline: auto;
        padding-inline: 0.625rem;
        max-width: 1280px;
        color: var(--color-text-primary);
        transition: all 0.3s ease-in-out;
    }

    .sidebar {
        position: fixed;
        top: 0;
        z-index: 2;
        width: 100%;
        height: 100dvh;
        background-color: var(--color-bg-menu);
        transform-origin: top left;
        scale: 0;
        transition-duration: 0.2s;
        transition-property: visibility, opacity, scale;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0;
        visibility: hidden;
        backdrop-filter: blur(40px);
    }

    .sidebar.open {
        scale: 1;
        opacity: 1;
        visibility: visible;
    }

    .sidebar__list {
        padding-top: 5.75rem;

        @media (width > 768px) {
            padding-top: 7.5rem;
        }
    }

    .sidebar__item {
        margin: 1.25rem;
        padding: 0 clamp(0rem, 1vw, 1.25rem);
    }
</style>
