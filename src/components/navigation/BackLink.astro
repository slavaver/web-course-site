---
import { getBasedUrl } from "@utils/paths";
const { path } = Astro.props;
---

<a
    href={path}
    class="back-link"
    ><img
        src={getBasedUrl("/assets/img/chevron-right.svg")}
        class="back-link__icon"
        alt=""
    /><span class="back-link__text">Назад</span></a
>

<style>
    .back-link {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 1.25rem;
        font-family: "NextArt", sans-serif;
        font-size: 20px;
        font-weight: 700;
    }

    .back-link__icon {
        margin-bottom: 0.25rem;
    }
</style>
