---
interface Props {
    title: string;
    href: string;
    number?: string;
    info?: string;
}

const { title, href, number, info } = Astro.props;
---

<a
    class="link-card"
    aria-label="Перейти к работе"
    href={href ? href : null}
>
    <div class="link-card__header">
        {number && <p class="link-card__number">{number.padStart(2, "0")}</p>}
        <h3 class="link-card__title">{title}</h3>
        {info && <p class="link-card__info">{info}</p>}
    </div>
    {
        href && (
            <div class="link-card__footer">
                <i
                    aria-label="Перейти к работе"
                    class="link-card__goto-icon"
                />
            </div>
        )
    }
</a>
<style>
    .link-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 220px;
        padding: 1.875rem;
        background-color: var(--color-bg-secondary);
        border-radius: 30px;
        transition-property: background-color;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;

        &:focus-visible {
            background-color: var(--color-bg-accent-second);
        }

        &:hover {
            background-color: var(--color-bg-accent-second);
        }

        &:active {
            background-color: var(--color-bg-primary);
        }
    }

    .link-card__header {
        display: flex;
        gap: 1.25rem;
    }

    .link-card__number {
        color: var(--color-number);
    }

    .link-card__title {
        font-family: "NextArt", sans-serif;
        font-weight: 500;
    }

    .link-card__footer {
        display: flex;
        justify-content: flex-end;
    }

    .link-card__goto-icon {
        background: url("/web-course-site/assets/img/goto.svg") no-repeat center;
        width: 50px;
        height: 50px;
        border: 1.5px solid var(--color-border);
        border-radius: 100%;
        color: var(--color-border);
    }
</style>
