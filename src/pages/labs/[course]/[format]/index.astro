---
import CourseLayout from "@layouts/CourseLayout.astro";
import { getCoursesInfo, getVariantPageData } from "@utils/registry";
import type { CourseType, FourDigitYear } from "@/types/Courses";

/**
 * Страница формата курса без года в URL: показывает ТЕКУЩИЙ год формата.
 * Сюда же попадают старые ссылки вида /labs/<курс>/distance/.
 */
export async function getStaticPaths() {
    const infos = await getCoursesInfo();
    return infos.flatMap((info) =>
        info.formats.map((item) => ({
            params: { course: info.id, format: item.format },
            props: {
                courseId: info.id,
                format: item.format,
                year: item.currentYear,
            },
        })),
    );
}

interface Props {
    courseId: string;
    format: CourseType;
    year: FourDigitYear;
}

const { courseId, format, year } = Astro.props as Props;
const page = await getVariantPageData(courseId, format, year);
if (!page) {
    throw new Error(`Вариант курса не найден: ${courseId}/${format}/${year}`);
}
---

<CourseLayout
    title={page.title}
    description={page.description}
    data={page.data}
    variant={page.variant}
/>
