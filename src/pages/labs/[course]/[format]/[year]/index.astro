---
import CourseLayout from "@layouts/CourseLayout.astro";
import { getCoursesInfo, getVariantPageData } from "@utils/registry";
import type { CourseType, FourDigitYear } from "@/types/Courses";

/**
 * Канонический URL конкретного варианта: /labs/<курс>/<формат>/<год>/.
 * Страницы создаются для всех существующих комбинаций, архивные варианты
 * помечаются ярлыком рядом с формой и годом поступления.
 */
export async function getStaticPaths() {
    const infos = await getCoursesInfo();
    return infos.flatMap((info) =>
        info.formats.flatMap((item) =>
            item.years.map((year) => ({
                params: { course: info.id, format: item.format, year },
                props: { courseId: info.id, format: item.format, year },
            })),
        ),
    );
}

interface Props {
    courseId: string;
    format: CourseType;
    year: FourDigitYear;
}

const { courseId, format, year } = Astro.props as Props;
const page = await getVariantPageData(courseId, format, year);
if (!page) {
    throw new Error(`Вариант курса не найден: ${courseId}/${format}/${year}`);
}
---

<CourseLayout title={page.title} data={page.data} variant={page.variant} />
