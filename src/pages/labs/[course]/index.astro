---
import BaseLayoutSnow from "@layouts/BaseLayoutSnow.astro";
import Heading from "@components/Heading.astro";
import Breadcrumbs from "@components/Navigation/Breadcrumbs.astro";
import FormatHubCard from "@components/FormatHubCard.astro";
import { getCoursesInfo } from "@utils/registry";
import { variantBreadcrumbs } from "@utils/breadcrumbs";
import type { CourseInfo } from "@utils/registry";

/**
 * Хаб курса: вместо списка материалов показываем форматы (очная/дистанционная)
 * с годом поступления, ссылкой на материалы и открытым списком прошлых лет.
 * История курса живёт здесь же — глобальный архив больше не нужен в меню.
 */
export async function getStaticPaths() {
    const infos = await getCoursesInfo();
    return infos
        .filter((info) => info.formats.length > 0)
        .map((info) => ({ params: { course: info.id }, props: { info } }));
}

interface Props {
    info: CourseInfo;
}

const { info } = Astro.props as Props;
---

<BaseLayoutSnow>
    <Heading title={info.title} description={info.description} />
    <Breadcrumbs items={variantBreadcrumbs(info.id)} />
    <section class="course-hub">
        <h2 class="course-hub__title">Варианты курса</h2>
        <div class="course-hub__grid">
            {info.formats.map((format) => (
                <FormatHubCard courseId={info.id} format={format} />
            ))}
        </div>
    </section>
</BaseLayoutSnow>

<style>
    .course-hub {
        margin-inline: auto;
        padding-inline: 1.25rem;
        padding-block: 3rem;
        max-width: 100vw;

        @media (width >= 768px) {
            padding-inline: 2.5rem;
        }

        @media (width >= 1280px) {
            max-width: 1280px;
        }
    }

    .course-hub__title {
        margin-bottom: 1.5rem;
        color: var(--color-text-inverted);
        text-align: center;
    }

    .course-hub__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.25rem;

        @media (width >= 768px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
