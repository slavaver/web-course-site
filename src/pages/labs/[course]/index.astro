---
import BaseLayoutSnow from "@layouts/BaseLayoutSnow.astro";
import Heading from "@components/Heading.astro";
import FormatHubCard from "@components/FormatHubCard.astro";
import { getCoursesInfo } from "@utils/registry";
import type { CourseInfo } from "@utils/registry";

/**
 * Хаб курса: вместо списка материалов показываем форматы (очная/дистанционная)
 * с актуальным годом и раскрывающимся списком прошлых лет.
 * История курса живёт здесь же — глобальный архив больше не нужен в меню.
 */
export async function getStaticPaths() {
    const infos = await getCoursesInfo();
    return infos
        .filter((info) => info.formats.length > 0)
        .map((info) => ({ params: { course: info.id }, props: { info } }));
}

interface Props {
    info: CourseInfo;
}

const { info } = Astro.props as Props;
---

<BaseLayoutSnow>
    <Heading title={info.title} description={info.description} />
    <section
        class="max-w-screen px-5 md:px-10 xl:max-w-screen-xl mx-auto mb-30">
        <h2 class="text-center text-text-inverted mb-10">Варианты курса</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {
                info.formats.map((format) => (
                    <FormatHubCard courseId={info.id} format={format} />
                ))
            }
        </div>
    </section>
</BaseLayoutSnow>
