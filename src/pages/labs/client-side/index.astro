---
import CourseLayout from "@layouts/CourseLayout.astro";
import { getCollection } from "astro:content";
import { filterCourse } from "@utils/courses";

const filter = filterCourse("2025", "full-time");
const course = await getCollection("clientSide", filter);
course.forEach((item) => {
    item.id = "client-side/" + item.id;
});
const items = Object.groupBy([...course], ({ data }) => data.type);
---

<CourseLayout
    title="Веб-разработка на стороне клиента"
    description="Изучаем основы работы с типами и язык TypeScript, а также осваиваем концепции фреймворков"
    data={items}
/>
