---
import Heading from "@components/Heading.astro";
import BaseLayoutSnow from "./BaseLayoutSnow.astro";
import CourseImportantSection from "@components/CourseSections/CourseImportantSection.astro";
import CourseExercisesSection from "@/components/CourseSections/CourseExercisesSection.astro";
import CourseLectureSection from "@/components/CourseSections/CourseLectureSection.astro";
import CourseRkSection from "@/components/CourseSections/CourseRkSection.astro";
import type { VariantContext } from "@utils/registry";

interface Props {
    title: string;
    // Материалы, сгруппированные по типу (important/labs/practice/lecture/rk)
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    data: Record<string, any>;
    /** Формат и год поступления варианта курса; неактуальные варианты помечаются ярлыком «архив» */
    variant?: Pick<VariantContext, "formatLabel" | "year" | "isCurrent">;
}

const { title, data, variant } = Astro.props;
---

<BaseLayoutSnow>
    <Heading title={title}>
        {variant && (
            <p class="course-variant">
                <span class="course-variant__format">
                    {variant.formatLabel} форма
                </span>
                <span class="course-variant__year">
                    {variant.year} год поступления
                </span>
                {!variant.isCurrent && (
                    <span class="course-variant__tag">архив</span>
                )}
            </p>
        )}
    </Heading>
    {data.important && <CourseImportantSection items={data.important} />}
    {data.labs && <CourseExercisesSection items={data.labs} />}
    {data.practice && <CourseExercisesSection items={data.practice} />}
    {data.lecture && <CourseLectureSection items={data.lecture} />}
    {data.rk && <CourseRkSection items={data.rk} />}
</BaseLayoutSnow>

<style>
    .course-variant {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.375rem 0.75rem;
        margin: 0;
    }

    .course-variant__format {
        font-weight: 600;
        font-family: var(--font-next-art);
    }

    .course-variant__tag {
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        background-color: var(--color-bg-accent-second);
        text-transform: lowercase;
        font-size: 0.875rem;
    }
</style>
